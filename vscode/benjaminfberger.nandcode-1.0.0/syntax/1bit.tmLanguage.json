{
	"name": "nandcode",
	"scopeName": "source.nand",
	"patterns": [
		{ "include": "#keywords" },
		{ "include": "#operators" },
		{ "include": "#comments" },
		{ "include": "#constants" }
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.nand",
					"match": "\\b(in|out):"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.nand.nand",
					"match": "!&|\\bnan\\b"
				},
				{
					"name": "keyword.operator.assignment.nand",
					"match": "="
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.number-sign.nand",
					"match": "#.*$"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.nand",
					"match": "\\b(true|false|1|0)\\b"
				}
			]
		}
	}
}
